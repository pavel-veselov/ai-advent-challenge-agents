# Copy this file to .env and fill in your GPUStack key.
# NOTE: .env is gitignored — never commit real secrets.

LLM_BASE_URL=https://gpustack.data.lmru.tech
LLM_API_KEY=your-gpustack-api-key
LLM_MODEL=glm-5.3-flash
EMBED_MODEL=qwen3-vl-embedding-8b
PORT=8081

# Optional: override project root scanned by RAG and used by MCP
# PROJECT_ROOT=/absolute/path/to/project

# Optional tuning
# MAX_CONTEXT=8
# SIMILARITY_THRESHOLD=0.5
