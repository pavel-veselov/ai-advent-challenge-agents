# Скопируйте файл в .env и заполните реальные значения.
# Токен и ключи в код не зашиваются — только через окружение.

# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=PASTE_TOKEN_HERE

# Стартовый провайдер LLM: gpustack | ollama
LLM_PROVIDER=gpustack

# Стартовая модель GPUStack (одна из каталога: qwen3.8-27b, deepseek-v4-flash, glm-5.3-flash)
LLM_MODEL=qwen3.8-27b

# Адрес GPUStack-сервера (без /v1 на конце)
LLM_BASE_URL=https://gpustack.data.lmru.tech

# Bearer-ключ GPUStack
LLM_API_KEY=PASTE_API_KEY_HERE

# Адрес локальной Ollama (OpenAI-совместимый /v1, без ключа)
LLM_OLLAMA_BASE_URL=http://localhost:11434
